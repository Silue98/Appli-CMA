// À remplacer dans prisma/schema.prisma
// Uniquement le modèle DemandeInscription — le reste du schéma ne change pas

model DemandeInscription {
  id                    Int            @id @default(autoincrement())
  nom                   String
  prenom                String
  sexe                  Sexe
  dateNaissance         DateTime?
  contact               String?
  email                 String?
  adresse               String?
  situationMatrimoniale String?
  profession            String?
  photo                 String?

  // ── Champs église & département (nouveaux) ──
  dateEntreeAleglise    DateTime?
  dateBaptemes          DateTime?
  activiteAuSeinDP      String?
  dateEntreeDepartement DateTime?

  statut                StatutDemande  @default(EN_ATTENTE)
  notesAdmin            String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}
