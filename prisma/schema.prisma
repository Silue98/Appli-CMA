// ---------------------------
// DATABASE CONFIGURATION
// ---------------------------
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------
// ENUMS (BONNES PRATIQUES)
// ---------------------------

enum Sexe {
  HOMME
  FEMME
}

enum StatusProgramme {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

enum TypeCulte {
  PREMIER
  DEUXIEME
  TROISIEME
}

// ---------------------------
// MEMBRE
// ---------------------------

model Membre {
  id            Int       @id @default(autoincrement())
  nom           String
  prenom        String
  sexe          Sexe
  dateNaissance DateTime?
  contact       String?
  email         String?   @unique
  adresse       String?
  situationMatrimoniale String?
  dateEntreeDepartement  DateTime?
  profession    String?
  activiteAuSeinDP String?
  dateInscription DateTime @default(now())
  photo         String?   // URL ou chemin de la photo
  // Relations
  activites            ActiviteMembre[]
  predications         Predication[] @relation("PredicationParMembre")
  programmesPlanifies  ProgrammeCulte[] @relation("PlanificateurProgramme")
  rolesAttribues       RoleProgramme[]
}

// ---------------------------
// PROGRAMME DE CULTE
// ---------------------------

model ProgrammeCulte {
  id              Int       @id @default(autoincrement())
  date            DateTime  @unique
  semaine         String?
  typeCulte       String?
  theme           String?

  cantiqueFrancais    String?
  cantiqueBaoule      String?
  cantiqueFrancaisRef String?
  cantiqueBaouleRef   String?

  notes           String? @db.Text
  status          StatusProgramme @default(PLANIFIE)

  // Responsable (relation nommée)
  planificateur   Membre? @relation("PlanificateurProgramme", fields: [planificateurId], references: [id])
  planificateurId Int?

  // Relations
  roles       RoleProgramme[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------
// ROLES DANS UN PROGRAMME
// ---------------------------

model RoleProgramme {
  id          Int       @id @default(autoincrement())

  programmeId Int
  programme   ProgrammeCulte @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  culteType   TypeCulte
  role        String
  heure       String?

  membreId    Int?
  membre      Membre? @relation(fields: [membreId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([programmeId, culteType, role])
}

// ---------------------------
// ACTIVITÉS D’UN MEMBRE
// ---------------------------

model ActiviteMembre {
  id           Int      @id @default(autoincrement())
  membreId     Int
  titre        String
  description  String?
  dateActivite DateTime

  membre       Membre   @relation(fields: [membreId], references: [id], onDelete: Cascade)
}

// ---------------------------
// CULTE (08H / 10H / 12H)
// ---------------------------

model Culte {
  id             Int      @id @default(autoincrement())
  dateCulte      DateTime
  horaire        String
  themePrincipal String?

  predications   Predication[]
  annonces       Annonce[]
}

// ---------------------------
// PREDICATION
// ---------------------------

model Predication {
  id            Int      @id @default(autoincrement())
  culteId       Int
  titre         String
  texteBiblique String
  resume        String?  @db.Text
  message       String?  @db.Text
  predicateurId Int

  culte       Culte  @relation(fields: [culteId], references: [id], onDelete: Cascade)
  predicateur Membre @relation("PredicationParMembre", fields: [predicateurId], references: [id])
}

// ---------------------------
// ANNONCE
// ---------------------------

model Annonce {
  id            Int      @id @default(autoincrement())
  culteId       Int
  titre         String

  infosJour     String? @db.Text
  remerciements String? @db.Text
  rappels       String? @db.Text
  commentaires  String?

  compteRendu   CompteRendu?

  culte         Culte   @relation(fields: [culteId], references: [id], onDelete: Cascade)
}

// ---------------------------
// COMPTE RENDU
// ---------------------------

model CompteRendu {
  id               Int      @id @default(autoincrement())
  annonceId        Int      @unique
  messager         String
  texteBiblique    String
  assistanceTotale Int
  theme            String

  annonce          Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
}